# Optional for native runs. Compose requires a generated hex database password.
POSTGRES_PASSWORD=
SENTINEL_DATABASE_URL=sqlite:///sentinel.db
SENTINEL_TIMEOUT=15
SENTINEL_CONCURRENCY=4
SENTINEL_MAX_ACTIVE=4
SENTINEL_CREATES_PER_MINUTE=10
SENTINEL_MAX_BYTES=65536
SENTINEL_RETRIES=1
SENTINEL_LOG_LEVEL=INFO
SENTINEL_PROFILES={}
SENTINEL_PROVIDER=off
SENTINEL_MIN_CONFIDENCE=0.85
# SENTINEL_JUDGE_PROFILE=judge
# SENTINEL_JUDGE_MODEL=your-deployed-model-id
# SENTINEL_PRICE_PER_MILLION_TOKENS=0
# Export SENTINEL_CRED_* in the process environment only.
